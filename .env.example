# 留空时使用内置本地演示数据；填写真实后端地址时优先请求远端 API。
VITE_API_BASE_URL=
VITE_API_TIMEOUT=4000
VITE_USE_MOCK=true

# 首页摘录卡默认请求历史同款随机古诗词源；失败或超时回退到仓库内置摘录。
# 设置为 false 可完全离线使用内置摘录；也可换成返回 content/origin/author/category 的兼容接口。
VITE_POETRY_SOURCE=jinrishici
VITE_POETRY_SOURCE_URL=https://v1.jinrishici.com/all.json
VITE_POETRY_SOURCE_TIMEOUT=4000

# 可选：配置后才启用 Supabase 客户端，否则使用本地演示适配器。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 默认使用 public/media/ 下的仓库自制演示音源。仅在已确认音源/封面授权时改为 custom，
# 并用 VITE_AUDIO_TRACKS 提供 JSON 音轨数组；配置无效时自动回退到本地演示音并显示提示。
VITE_AUDIO_SOURCE=local
VITE_AUDIO_TRACKS=
