# 留空时使用内置本地演示数据；填写真实后端地址时优先请求远端 API。
VITE_API_BASE_URL=
VITE_API_TIMEOUT=4000
VITE_USE_MOCK=true

# 首页摘录卡默认只使用仓库内置摘录；设为 remote 才请求随机古诗词源。
# 远程接口失败或超时会自动回退内置摘录；也可换成返回 content/origin/author/category 的兼容接口。
VITE_POETRY_SOURCE=local
VITE_POETRY_SOURCE_URL=https://v1.jinrishici.com/all.json
VITE_POETRY_SOURCE_TIMEOUT=4000

# 默认恢复旧版五首网易云外链直连（不下载音频文件，不读取下方变量）。
# 仅显式设为 custom 并用 VITE_AUDIO_TRACKS 提供 JSON 数组时才切换；配置无效自动回退旧版外链并显示提示。
VITE_AUDIO_SOURCE=legacy
VITE_AUDIO_TRACKS=

# 仅本机播放自有音频时：把文件放入 public/media/private/（已 gitignore），运行 npm run audio:private。
# 脚本会生成同样被忽略的 .env.local.audio 并以 --mode local.audio 启动 dev，不影响默认构建与 Pages。
