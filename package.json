{
  "name": "LanZe",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "smoke:browser": "node scripts/smoke.browser.mjs",
    "measure:excerpt": "node scripts/measure-excerpt-switch.mjs",
    "inspect:spacing": "node scripts/measure-ui-spacing.mjs",
    "test": "node --test --test-concurrency=1 scripts/*.test.mjs src/config/*.test.js src/data/*.test.js src/services/*.test.js src/utils/*.test.js src/composables/*.test.js",
    "lint": "node src/utils/lint.mjs",
    "capture:brand": "node scripts/capture-brand.mjs",
    "verify:render": "node scripts/browser/verify-render.mjs",
    "capture:brand:1x1": "node scripts/browser/capture-brand-1x1.mjs",
    "audit:a11y": "node scripts/browser/a11y-audit.mjs",
    "audit:perf": "node scripts/browser/perf-budget.mjs",
    "audit:visual": "node scripts/browser/visual-baseline.mjs",
    "audit:visual:update": "node scripts/browser/visual-baseline.mjs --update",
    "audit:layout": "node scripts/browser/layout-contract.mjs",
    "audit:layout:update": "node scripts/browser/layout-contract.mjs --update",
    "audit:motion": "node scripts/browser/motion-audit.mjs",
    "audit:touch": "node scripts/browser/touch-target-audit.mjs",
    "render:originals": "node scripts/render-originals.mjs"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "motion": "^12.43.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "axe-core": "^4.14.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "vite": "^6.4.6"
  }
}
